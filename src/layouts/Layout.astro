---
import '@/styles/global.css';
import AppFooter from "@/components/AppFooter.astro";
import AppHeader from "@/components/AppHeader.astro";

import { getLangFromUrl } from '@/i18n/utils';
const lang = getLangFromUrl(Astro.url);

export interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet" />
		<meta name="description" content="Aplikasi dengan fitur pencatatan pendapatan dan pengeluaran, memonitor profitabilitas, serta melakukan perencanaan keuangan untuk usaha pertanian.">
		<meta name="keywords" content="Pertanian, Milenial, Keuangan, Manajemen, Monitoring">

		<title>{title}</title>

		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content="Aplikasi dengan fitur pencatatan pendapatan dan pengeluaran, memonitor profitabilitas, serta melakukan perencanaan keuangan untuk usaha pertanian." />
		<meta property="og:url" content="https://finatani-website.web.app/" />
		<meta property="og:image" content="https://raw.githubusercontent.com/finatani/website/main/public/finatani_homepage.webp" />
		<meta property="og:image:alt" content={title} />
		<meta property="og:image:width" content="300" />
		<meta property="og:image:height" content="250" />
	
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content="@eko_sutrisno96" />
		<meta name="twitter:creator" content="@eko_sutrisno96" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content="Aplikasi dengan fitur pencatatan pendapatan dan pengeluaran, memonitor profitabilitas, serta melakukan perencanaan keuangan untuk usaha pertanian." />
		<meta name="twitter:image" content="https://raw.githubusercontent.com/finatani/website/main/public/finatani_homepage.webp" />
		<meta name="twitter:image:alt" content={title} />

		<script type="text/partytown" src="https://www.googletagmanager.com/gtag/js?id=G-DFFHYJ0HBX"></script>
		<script type="text/partytown">
			window.dataLayer = window.dataLayer || [];
			function gtag() {
				dataLayer.push(arguments);
			}
			gtag("js", new Date());
			gtag("config", "G-DFFHYJ0HBX");
		</script>

	</head>
	<body class="bg-cream text-gray-900 antialiased">
		<AppHeader/>
		<slot />
		<AppFooter/>


		<script is:inline>
			window.$zoho = window.$zoho || {};
			$zoho.salesiq = $zoho.salesiq || {
				ready:function(){}}
		</script>
		<script is:inline id="zsiqscript" src="https://salesiq.zohopublic.com/widget?wc=siq1b89c9895e8e2a9e12a3c6fa3342227599721060c770c04fa06c07f16e45b5b2" defer></script>
	</body>
</html>