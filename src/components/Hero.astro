---
import Container from "./Container.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const commodities = [
    {
        icon: "🌾",
        name: t("commodity.rice"),
        price: "Rp6.700/kg",
        delta: "+2,1%",
        up: true,
    },
    {
        icon: "🌽",
        name: t("commodity.corn"),
        price: "Rp5.250/kg",
        delta: "+1,4%",
        up: true,
    },
    {
        icon: "🌶️",
        name: t("commodity.chili"),
        price: "Rp38.500/kg",
        delta: "-3,2%",
        up: false,
    },
];

const tags = [
    t("hero.tagOne"),
    t("hero.tagTwo"),
    t("hero.tagThree"),
    t("hero.tagMore"),
];
---

<section id="home">
    <Container>
        <div class="grid items-center gap-10 pt-6 md:gap-14 md:pt-14 lg:grid-cols-2">
            <div>
                <p class="text-sm font-semibold text-mainGreen">
                    {t("hero.eyebrow")}
                </p>
                <h1
                    class="mt-4 text-4xl font-bold leading-tight tracking-tight text-gray-900 md:text-5xl xl:text-6xl"
                >
                    {t("hero.titleLead")}
                    <span class="text-mainGreen"
                        >{t("hero.titleHighlight")}</span
                    >
                </h1>
                <p class="mt-6 max-w-md text-gray-600 md:text-lg">
                    {t("hero.description")}
                </p>

                <form
                    class="mt-8 flex max-w-sm items-center gap-2 rounded-full bg-white p-2 pl-5 shadow-sm ring-1 ring-gray-200"
                    action="#cta"
                >
                    <input
                        type="text"
                        placeholder={t("hero.inputPlaceholder")}
                        class="w-full bg-transparent text-sm text-gray-900 placeholder-gray-400 focus:outline-hidden"
                    />
                    <button
                        type="submit"
                        aria-label="Send"
                        class="grid h-10 w-10 shrink-0 cursor-pointer place-items-center rounded-full bg-mainGreen text-white hover:bg-secondaryGreen"
                    >
                        <svg
                            aria-hidden="true"
                            class="h-4 w-4"
                            xmlns="http://www.w3.org/2000/svg"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            stroke-width="2.5"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M13.5 4.5L21 12l-7.5 7.5M21 12H3"
                            ></path></svg
                        >
                    </button>
                </form>

                <div class="mt-8 flex flex-wrap gap-2">
                    {
                        tags.map((tag) => (
                            <span class="rounded-full bg-white px-4 py-1.5 text-xs font-medium text-gray-600 ring-1 ring-gray-200">
                                {tag}
                            </span>
                        ))
                    }
                </div>
            </div>

            <div class="relative mx-auto w-full max-w-lg">
                <img
                    src="https://images.unsplash.com/photo-1605000797499-95a51c5269ae?q=80&w=900&auto=format&fit=crop"
                    alt={t("hero.imageAlt")}
                    class="h-100 w-full rounded-[2.5rem] object-cover md:h-135"
                    loading="eager"
                />

                <div
                    class="absolute -right-3 top-10 w-60 rounded-2xl bg-white/95 p-4 shadow-xl backdrop-blur md:-right-8"
                >
                    <p class="text-xs font-semibold text-gray-900">
                        {t("widget.todayReport")}
                    </p>
                    <ul class="mt-3 space-y-2.5">
                        {
                            commodities.map((c) => (
                                <li class="flex items-center gap-2.5">
                                    <span class="grid h-8 w-8 shrink-0 place-items-center rounded-lg bg-cream text-base">
                                        {c.icon}
                                    </span>
                                    <div class="min-w-0 flex-1">
                                        <p class="truncate text-xs font-semibold text-gray-900">
                                            {c.name}
                                        </p>
                                        <p class="text-[11px] text-gray-500">
                                            {c.price}
                                        </p>
                                    </div>
                                    <span
                                        class:list={[
                                            "text-[11px] font-semibold",
                                            c.up
                                                ? "text-mainGreen"
                                                : "text-red-500",
                                        ]}
                                    >
                                        {c.delta}
                                    </span>
                                </li>
                            ))
                        }
                    </ul>
                </div>

                <div
                    class="absolute -left-3 bottom-28 flex items-center gap-3 rounded-2xl bg-white/95 px-4 py-3 shadow-xl backdrop-blur md:-left-10"
                >
                    <span
                        class="grid h-9 w-9 place-items-center rounded-lg bg-cream text-lg"
                        >🌾</span
                    >
                    <div>
                        <p class="text-xs font-semibold text-gray-900">
                            {t("commodity.rice")}
                        </p>
                        <p class="text-[11px] text-gray-500">
                            Rp6.700/kg <span
                                class="font-semibold text-mainGreen">▲</span
                            >
                        </p>
                    </div>
                </div>

                <div
                    class="absolute bottom-5 left-1/2 flex w-[85%] -translate-x-1/2 items-center gap-3 rounded-full bg-white/95 p-2 pr-2.5 shadow-xl backdrop-blur"
                >
                    <span
                        class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-mainGreen text-sm font-bold text-white"
                        >AS</span
                    >
                    <div class="min-w-0 flex-1">
                        <p class="truncate text-sm font-semibold text-gray-900">
                            {t("hero.profileName")}
                        </p>
                        <p class="truncate text-xs text-gray-500">
                            {t("hero.profileRole")}
                        </p>
                    </div>
                    <span
                        class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-gray-900 text-white"
                    >
                        <svg
                            aria-hidden="true"
                            class="h-4 w-4"
                            xmlns="http://www.w3.org/2000/svg"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            stroke-width="2"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M7 17L17 7M9 7h8v8"></path></svg
                        >
                    </span>
                </div>
            </div>
        </div>
    </Container>
</section>
