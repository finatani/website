---
import Container from "./Container.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="insights">
    <Container>
        <div class="grid gap-6 lg:grid-cols-3">
            <div
                class="flex min-w-0 flex-col items-center justify-center rounded-[2.5rem] bg-mainGreen p-8 text-center md:p-12 lg:col-span-2"

            >
                <h2
                    class="mx-auto max-w-lg text-2xl font-bold text-white md:text-3xl"
                >
                    {t("showcase.title")}
                </h2>
                <p class="mx-auto mt-4 max-w-md text-sm text-white/80 md:text-base">
                    {t("showcase.caption")}
                </p>

                <div class="mt-8">
                    <a
                        href="https://pasar.finatani.com/"
                        target="_blank"
                        rel="noopener"
                        class="inline-flex items-center gap-2 rounded-full bg-white px-6 py-3 text-sm font-semibold text-mainGreen shadow-lg hover:bg-cream"
                    >
                        {t("showcase.cta")}
                        <svg
                            aria-hidden="true"
                            class="h-4 w-4"
                            xmlns="http://www.w3.org/2000/svg"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            stroke-width="2.5"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M13.5 4.5L21 12l-7.5 7.5M21 12H3"
                            ></path></svg
                        >
                    </a>
                </div>
            </div>

            <div
                class="relative min-h-64 overflow-hidden rounded-[2.5rem] md:min-h-95"


            >
                <img
                    src="https://images.unsplash.com/photo-1500937386664-56d1dfef3854?q=80&w=900&auto=format&fit=crop"
                    alt={t("showcase.imageAlt")}
                    class="absolute inset-0 h-full w-full object-cover"
                    loading="lazy"
                />
                <div
                    class="absolute inset-0 bg-linear-to-t from-gray-900/80 via-gray-900/20 to-transparent"
                >
                </div>
                <p
                    class="absolute bottom-6 left-6 right-6 text-lg font-semibold text-white"
                >
                    {t("showcase.overlay")}
                </p>
            </div>
        </div>
    </Container>
</section>
