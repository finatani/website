---
import Container from './Container.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const chips = [
  { icon: '🌾', name: t('commodity.rice'), price: 'Rp6.700/kg', delta: '+2,1%', up: true },
  { icon: '🌽', name: t('commodity.corn'), price: 'Rp5.250/kg', delta: '+1,4%', up: true },
  { icon: '🌶️', name: t('commodity.chili'), price: 'Rp38.500/kg', delta: '-3,2%', up: false },
  { icon: '🥚', name: t('commodity.egg'), price: 'Rp27.000/kg', delta: '+0,8%', up: true },
];
---

<section id="features">
  <Container>
    <div class="grid gap-10 lg:grid-cols-2 lg:items-end">
      <div>
        <p class="text-sm font-semibold text-mainGreen">{t('tracking.eyebrow')}</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-gray-900 md:text-4xl">
          {t('tracking.titleLead')} <span class="text-mainGreen">{t('tracking.titleHighlight')}</span><br class="hidden md:block" /> {t('tracking.titleTail')}
        </h2>
        <p class="mt-4 max-w-md text-gray-600 md:text-lg">{t('tracking.description')}</p>
      </div>

      <div>
        <p class="flex items-center gap-2 text-sm font-semibold text-gray-900">
          <span class="grid h-7 w-7 place-items-center rounded-lg bg-mainGreen/10 text-mainGreen">
            <svg aria-hidden="true" class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20"><path d="M2 11a1 1 0 011-1h2a1 1 0 011 1v5a1 1 0 01-1 1H3a1 1 0 01-1-1v-5zM8 7a1 1 0 011-1h2a1 1 0 011 1v9a1 1 0 01-1 1H9a1 1 0 01-1-1V7zM14 4a1 1 0 011-1h2a1 1 0 011 1v12a1 1 0 01-1 1h-2a1 1 0 01-1-1V4z"/></svg>
          </span>
          {t('insights.label')}
        </p>
        <div class="mt-4 flex flex-wrap gap-3">
          {chips.map((chip) => (
            <div class="flex items-center gap-2.5 rounded-full bg-white py-2 pl-2.5 pr-4 shadow-sm ring-1 ring-gray-200">
              <span class="grid h-8 w-8 place-items-center rounded-full bg-cream text-base">{chip.icon}</span>
              <div>
                <p class="text-xs font-semibold text-gray-900">{chip.name}</p>
                <p class="text-[11px] text-gray-500">{chip.price} <span class:list={["font-semibold", chip.up ? 'text-mainGreen' : 'text-red-500']}>{chip.delta}</span></p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </Container>
</section>
