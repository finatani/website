---
import Container from './Container.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="cta">
  <Container>
    <div class="mx-auto max-w-2xl text-center">
      <span class="mx-auto grid h-12 w-12 place-items-center rounded-full bg-secondary/15 text-xl">🌱</span>
      <p class="mt-5 text-sm font-semibold text-mainGreen">{t('cta.eyebrow')}</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-gray-900 md:text-5xl">{t('cta.title')}</h2>
      <p class="mx-auto mt-5 max-w-md text-gray-600 md:text-lg">{t('cta.description')}</p>

      <div class="mx-auto mt-8 grid max-w-lg gap-4 sm:grid-cols-2 sm:gap-6 md:mt-10">
        <div class="rounded-3xl bg-white p-6 ring-1 ring-gray-100">
          <p class="text-gray-900"><span class="text-3xl font-bold text-mainGreen">{t('cta.statOneValue')}</span> {t('cta.statOneUnit')}</p>
          <p class="mt-1.5 text-sm text-gray-500">{t('cta.statOneText')}</p>
        </div>
        <div class="rounded-3xl bg-white p-6 ring-1 ring-gray-100">
          <p class="text-gray-900"><span class="text-3xl font-bold text-mainGreen">{t('cta.statTwoValue')}</span> {t('cta.statTwoUnit')}</p>
          <p class="mt-1.5 text-sm text-gray-500">{t('cta.statTwoText')}</p>
        </div>
      </div>
    </div>
  </Container>
</section>
