---
import Container from "./Container.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const commodities = [
    {
        icon: "🌾",
        name: t("commodity.rice"),
        price: "Rp6.700/kg",
        delta: "+2,1%",
        up: true,
    },
    {
        icon: "🌶️",
        name: t("commodity.chili"),
        price: "Rp38.500/kg",
        delta: "-3,2%",
        up: false,
    },
    {
        icon: "🥚",
        name: t("commodity.egg"),
        price: "Rp27.000/kg",
        delta: "+0,8%",
        up: true,
    },
];

const tags = [t("hero.tagOne"), t("hero.tagTwo"), t("hero.tagThree")];
const pills = [t("assistant.pillCoaching"), t("assistant.pillCommunity")];

const legend = [
    { label: t("chart.income"), color: "bg-mainGreen" },
    { label: t("chart.expense"), color: "bg-secondary" },
    { label: t("chart.profit"), color: "bg-gray-300" },
];

const bars = [
    { height: 55, color: "bg-mainGreen/80" },
    { height: 80, color: "bg-secondary/80" },
    { height: 65, color: "bg-gray-200" },
    { height: 90, color: "bg-mainGreen/80" },
    { height: 50, color: "bg-secondary/80" },
    { height: 75, color: "bg-mainGreen/80" },
    { height: 60, color: "bg-gray-200" },
];
const days = t("chart.days").split(",");
---

<section>
    <Container>
        <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-12">
            <div
                class="relative mx-auto w-full max-w-lg pb-12"

            >
                <img
                    src="https://images.unsplash.com/photo-1464226184884-fa280b87c399?q=80&w=900&auto=format&fit=crop"
                    alt={t("assistant.imageAlt")}
                    class="h-90 w-full rounded-[2.5rem] object-cover md:h-115"
                    loading="lazy"
                />

                <div
                    class="absolute bottom-0 left-1/2 w-[88%] -translate-x-1/2 rounded-2xl bg-white p-5 shadow-xl"
                >
                    <div class="flex flex-wrap gap-x-4 gap-y-1">
                        {
                            legend.map((item) => (
                                <span class="flex items-center gap-1.5 text-[11px] font-medium text-gray-600">
                                    <span
                                        class:list={[
                                            "h-2 w-2 rounded-full",
                                            item.color,
                                        ]}
                                    />
                                    {item.label}
                                </span>
                            ))
                        }
                    </div>
                    <div class="mt-4 flex h-24 items-end justify-between gap-2">
                        {
                            bars.map((bar) => (
                                <span
                                    class:list={["w-4 rounded-full", bar.color]}
                                    style={`height:${bar.height}%`}
                                />
                            ))
                        }
                    </div>
                    <div
                        class="mt-2 flex justify-between text-[10px] font-medium text-gray-400"
                    >
                        {
                            days.map((day) => (
                                <span class="w-4 text-center">{day}</span>
                            ))
                        }
                    </div>
                </div>
            </div>

            <div>
                <p class="text-sm font-semibold text-mainGreen">
                    {t("assistant.eyebrow")}
                </p>
                <h2
                    class="mt-3 text-3xl font-bold tracking-tight text-gray-900 md:text-4xl"
                >
                    {t("assistant.titleLead")}<br class="hidden md:block" />
                    {t("assistant.titleTail")}
                </h2>

                <div
                    class="mt-8 rounded-3xl bg-white p-5 shadow-sm ring-1 ring-gray-100"
                >
                    <p
                        class="flex items-center gap-2 text-sm font-semibold text-gray-900"
                    >
                        <span
                            class="grid h-7 w-7 place-items-center rounded-lg bg-mainGreen/10 text-mainGreen"
                        >
                            <svg
                                aria-hidden="true"
                                class="h-4 w-4"
                                xmlns="http://www.w3.org/2000/svg"
                                fill="currentColor"
                                viewBox="0 0 20 20"
                                ><path
                                    d="M2 11a1 1 0 011-1h2a1 1 0 011 1v5a1 1 0 01-1 1H3a1 1 0 01-1-1v-5zM8 7a1 1 0 011-1h2a1 1 0 011 1v9a1 1 0 01-1 1H9a1 1 0 01-1-1V7zM14 4a1 1 0 011-1h2a1 1 0 011 1v12a1 1 0 01-1 1h-2a1 1 0 01-1-1V4z"
                                ></path></svg
                            >
                        </span>
                        {t("insights.label")}
                    </p>
                    <ul class="mt-4 space-y-3">
                        {
                            commodities.map((c) => (
                                <li class="flex items-center gap-2.5">
                                    <span class="grid h-8 w-8 shrink-0 place-items-center rounded-lg bg-cream text-base">
                                        {c.icon}
                                    </span>
                                    <div class="min-w-0 flex-1">
                                        <p class="truncate text-xs font-semibold text-gray-900">
                                            {c.name}
                                        </p>
                                        <p class="text-[11px] text-gray-500">
                                            {c.price}
                                        </p>
                                    </div>
                                    <span
                                        class:list={[
                                            "text-[11px] font-semibold",
                                            c.up
                                                ? "text-mainGreen"
                                                : "text-red-500",
                                        ]}
                                    >
                                        {c.delta}
                                    </span>
                                </li>
                            ))
                        }
                    </ul>
                    <div
                        class="mt-4 flex flex-wrap gap-2 border-t border-gray-100 pt-4"
                    >
                        {
                            tags.map((tag) => (
                                <span class="rounded-full bg-cream px-4 py-1.5 text-xs font-medium text-gray-600">
                                    {tag}
                                </span>
                            ))
                        }
                    </div>
                </div>

                <div class="mt-4 space-y-3">
                    {
                        pills.map((label) => (
                            <a
                                href="#cta"
                                class="flex items-center justify-between rounded-full bg-gray-900 px-6 py-4 text-sm font-semibold text-white hover:bg-secondaryGreen"
                            >
                                {label}
                                <svg
                                    aria-hidden="true"
                                    class="h-4 w-4"
                                    xmlns="http://www.w3.org/2000/svg"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                    stroke-width="2.5"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        d="M12 4.5v15m7.5-7.5h-15"
                                    />
                                </svg>
                            </a>
                        ))
                    }
                </div>
            </div>
        </div>

        <p
            class="mx-auto mt-10 max-w-lg text-center text-sm text-gray-500 md:mt-16 md:text-base"
        >
            {t("assistant.caption")}
        </p>
    </Container>
</section>
