---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { languages } from '@/i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const links = [
  { href: '#home', label: t('nav.home') },
  { href: '#features', label: t('nav.features') },
  { href: '#insights', label: t('nav.insights') },
  { href: '#footer', label: t('nav.community') },
];
---

<header class="sticky top-0 z-40 bg-cream/80 backdrop-blur-md">
  <nav class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-6 py-4 md:px-12 xl:px-6">
    <a href={`/${lang}/`} class="flex shrink-0 items-center">
      <img src="/finatani_logo.png" class="h-8" alt="FinaTani Logo" />
    </a>

    <ul class="hidden items-center gap-8 text-sm font-medium text-gray-700 md:flex">
      {links.map(({ href, label }) => (
        <li><a href={href} class="hover:text-mainGreen">{label}</a></li>
      ))}
    </ul>

    <div class="relative flex items-center gap-2">
      <button type="button" aria-label="Change language" data-dropdown-toggle="language-dropdown-menu" aria-expanded="false" class="inline-flex cursor-pointer items-center gap-1 rounded-full px-3 py-2 text-sm font-semibold text-gray-700 hover:bg-white">
        {lang.toUpperCase()}
        <svg aria-hidden="true" class="h-4 w-4 text-gray-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path fill="currentColor" d="M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6l-6-6l1.41-1.41z"/></svg>
      </button>
      <div class="absolute right-0 top-full z-50 mt-2 hidden w-44 overflow-hidden rounded-2xl bg-white shadow-lg ring-1 ring-gray-100" id="language-dropdown-menu">
        <ul class="py-2 text-sm font-medium" role="none">
          {Object.entries(languages).map(([code, label]) => (
            <li>
              <a href={`/${code}/`} role="menuitem" class:list={["block px-4 py-2 hover:bg-gray-50", code === lang ? 'font-semibold text-mainGreen' : 'text-gray-700']}>
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <a href="#cta" class="hidden items-center gap-2 rounded-full bg-gray-900 px-5 py-2.5 text-sm font-semibold text-white hover:bg-secondaryGreen sm:inline-flex">
        {t('nav.join')}
        <svg aria-hidden="true" class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20"><path d="M8 9a3 3 0 100-6 3 3 0 000 6zM8 11a6 6 0 016 6H2a6 6 0 016-6zM16 7a1 1 0 10-2 0v1h-1a1 1 0 100 2h1v1a1 1 0 102 0v-1h1a1 1 0 100-2h-1V7z"/></svg>
      </a>

      <button data-collapse-toggle="mobile-menu" type="button" class="inline-flex items-center rounded-lg p-2 text-sm text-gray-600 hover:bg-white focus:outline-hidden focus:ring-2 focus:ring-gray-200 md:hidden" aria-controls="mobile-menu" aria-expanded="false">
        <span class="sr-only">Open main menu</span>
        <svg class="h-6 w-6" fill="currentColor" aria-hidden="true" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 10a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 15a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z" clip-rule="evenodd"></path></svg>
      </button>
    </div>
  </nav>

  <div class="hidden px-6 pb-4 md:hidden" id="mobile-menu">
    <ul class="flex flex-col gap-1 rounded-2xl bg-white p-3 font-medium text-gray-700 shadow-sm ring-1 ring-gray-100">
      {links.map(({ href, label }) => (
        <li><a href={href} class="block rounded-xl px-4 py-2.5 hover:bg-cream hover:text-mainGreen">{label}</a></li>
      ))}
      <li><a href="#cta" class="block rounded-xl px-4 py-2.5 font-semibold text-mainGreen">{t('nav.join')}</a></li>
    </ul>
  </div>
</header>

<script>
  for (const attribute of ['data-dropdown-toggle', 'data-collapse-toggle']) {
    document.querySelectorAll(`[${attribute}]`).forEach((button) => {
      const target = document.getElementById(button.getAttribute(attribute) ?? '');
      if (!target) return;
      button.addEventListener('click', () => {
        const isHidden = target.classList.toggle('hidden');
        button.setAttribute('aria-expanded', String(!isHidden));
      });
    });
  }

  document.addEventListener('click', (event) => {
    document.querySelectorAll('[data-dropdown-toggle]').forEach((button) => {
      const target = document.getElementById(button.getAttribute('data-dropdown-toggle') ?? '');
      if (!target || target.classList.contains('hidden')) return;
      if (!(event.target instanceof Node)) return;
      if (button.contains(event.target) || target.contains(event.target)) return;
      target.classList.add('hidden');
      button.setAttribute('aria-expanded', 'false');
    });
  });
</script>
